{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["worker.ts", "cloudflare.config.ts", "wrangler.config.ts", "types.d.ts", "production/**/*.ts"],
  "exclude": ["node_modules", ".build-input", ".cloudflare", ".required-tool-outputs"]
}
