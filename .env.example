# cyber-strategy 环境变量（全部服务端使用，禁止 VITE_ 前缀）

# 应用会话 / OAuth state 加密。用随机 32+ 字节字符串。
SESSION_SECRET=

# 飞书自建应用（组织身份登录）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书 Wiki 视频库。应用需开通 wiki:wiki:readonly 或 wiki:node:read，并能访问该知识库。
FEISHU_VIDEO_LIBRARY_URL=
# 允许登录的飞书租户 key（组织 allow-list，逗号分隔）。留空表示不校验租户。
FEISHU_ALLOWED_TENANT_KEYS=
# OAuth 回调的规范站点 origin，例如 https://cyber-strategy.vercel.app
APP_BASE_URL=

# Supabase（仅服务端 service_role；前端绝不读取）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# cyber-scout 原始数据源（仅服务端 service_role；用于实时读取 scouting_records 和 pit-photos）
CYBER_SCOUT_SUPABASE_URL=
CYBER_SCOUT_SUPABASE_SERVICE_ROLE_KEY=

# FIRST FRC Events API（仅服务端；比赛结果首选来源）
FRC_EVENTS_USERNAME=
FRC_EVENTS_API_KEY=

# The Blue Alliance（仅服务端；用于队伍综合分的比赛分项）
TBA_API_KEY=
