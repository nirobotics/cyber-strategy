# cyber-strategy 环境变量（全部服务端使用，禁止 VITE_ 前缀）
# 赛季不通过环境变量切换；每个年度分支在 app/season/ 中维护单一赛季配置。

# 应用会话 / OAuth state 加密。用随机 32+ 字节字符串。
SESSION_SECRET=

# 飞书自建应用（组织身份登录）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书 Wiki 视频库。应用需开通 wiki:wiki:readonly 或 wiki:node:read，并能访问该知识库。
FEISHU_VIDEO_LIBRARY_URL=
# 允许登录的飞书租户 key（必填，组织 allow-list，逗号分隔）。未配置时拒绝登录。
FEISHU_ALLOWED_TENANT_KEYS=
# OAuth 回调的规范站点 origin，例如本地 http://localhost:5173 或生产 https://cyber-strategy.vercel.app
APP_BASE_URL=

# Supabase（仅服务端 service_role；前端绝不读取）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cyber Scout（仅服务端 service_role；读取 Normal/Super/Pit、照片、提交记录和人员分配）
CYBER_SCOUT_SUPABASE_URL=
CYBER_SCOUT_SUPABASE_SERVICE_ROLE_KEY=

# FIRST FRC Events API（仅服务端；读取赛程、阵容和首选官方比赛结果）
FRC_EVENTS_USERNAME=
FRC_EVENTS_API_KEY=

# The Blue Alliance（仅服务端；补充比赛身份、阵容、结果、视频和年度 score_breakdown）
TBA_API_KEY=

# Cyber Pit 服务端预检与短时签名嵌入页（两端配置同一随机值）
CYBER_STRATEGY_EMBED_SECRET=
